{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827"}, "$description": "Default text"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4b5563"}, "$description": "Secondary text, hints, timestamps"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page and surface background"},
  "color-bg-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647], "hex": "#f3f4f6"}, "$description": "Quiet fills: hover, skeleton, neutral badge"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db"}, "$description": "Decorative dividers and card edges"},
  "color-border-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.4196, 0.4471, 0.502], "hex": "#6b7280"}, "$description": "Form control edges"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Brand, primary actions, links, focus ring"},
  "color-primary-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.251, 0.6863], "hex": "#1e40af"}, "$description": "Primary hover"},
  "color-on-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary and danger fills"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Destructive actions and errors"},
  "color-danger-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.6, 0.1059, 0.1059], "hex": "#991b1b"}},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.949, 0.949], "hex": "#fef2f2"}},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0863, 0.3961, 0.2039], "hex": "#166534"}},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9412, 0.9922, 0.9569], "hex": "#f0fdf4"}},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5725, 0.251, 0.0549], "hex": "#92400e"}},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 0.9843, 0.9216], "hex": "#fffbeb"}},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.2275, 0.5412], "hex": "#1e3a8a"}},
  "color-info-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9373, 0.9647, 1], "hex": "#eff6ff"}},
  "color-scrim": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827"}, "$description": "Backdrop behind modals; dimmed with opacity-scrim"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},
  "space-5": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}},
  "space-6": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}},

  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
  "radius-lg": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}},

  "font-size-sm": {"$type": "dimension", "$value": {"value": 0.875, "unit": "rem"}},
  "font-size-md": {"$type": "dimension", "$value": {"value": 1, "unit": "rem"}},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 1.25, "unit": "rem"}},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 1.75, "unit": "rem"}},

  "size-control-sm": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}},
  "size-control": {"$type": "dimension", "$value": {"value": 44, "unit": "px"}},
  "size-control-lg": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}},
  "size-avatar-sm": {"$type": "dimension", "$value": {"value": 28, "unit": "px"}},
  "size-avatar": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}},
  "size-avatar-lg": {"$type": "dimension", "$value": {"value": 64, "unit": "px"}},
  "size-check": {"$type": "dimension", "$value": {"value": 18, "unit": "px"}},
  "size-switch-width": {"$type": "dimension", "$value": {"value": 44, "unit": "px"}},
  "size-switch-height": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},
  "size-switch-knob": {"$type": "dimension", "$value": {"value": 18, "unit": "px"}},
  "size-spinner": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},
  "size-skeleton-line": {"$type": "dimension", "$value": {"value": 14, "unit": "px"}},
  "size-textarea-min": {"$type": "dimension", "$value": {"value": 96, "unit": "px"}},
  "size-menu-min": {"$type": "dimension", "$value": {"value": 192, "unit": "px"}},
  "size-tooltip-max": {"$type": "dimension", "$value": {"value": 240, "unit": "px"}},
  "size-toast": {"$type": "dimension", "$value": {"value": 320, "unit": "px"}},
  "size-drawer": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}},
  "size-modal": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}},
  "size-grid-min": {"$type": "dimension", "$value": {"value": 240, "unit": "px"}},
  "size-container": {"$type": "dimension", "$value": {"value": 720, "unit": "px"}, "$description": "Max content width: single-column timeline reads best at this measure"},
  "size-frame": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Height of in-page overlay sample frames in the style guide"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
  "border-width-strong": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}},

  "font-family-base": {"$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"},
  "font-family-mono": {"$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700},
  "line-height-base": {"$type": "number", "$value": 1.5},
  "line-height-tight": {"$type": "number", "$value": 1.25},
  "opacity-disabled": {"$type": "number", "$value": 0.5},
  "opacity-scrim": {"$type": "number", "$value": 0.5},
  "opacity-skeleton": {"$type": "number", "$value": 0.4},
  "motion-spin": {"$type": "number", "$value": 0.8, "$description": "Seconds per spinner turn"},
  "motion-pulse": {"$type": "number", "$value": 1.5, "$description": "Seconds per skeleton pulse"},
  "z-dropdown": {"$type": "number", "$value": 10},
  "z-backdrop": {"$type": "number", "$value": 20},
  "z-modal": {"$type": "number", "$value": 30},
  "z-toast": {"$type": "number", "$value": 40},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-primary-hover-background": {"$type": "color", "$value": "{color-primary-hover}"},
  "button-secondary-background": {"$type": "color", "$value": "{color-bg}"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border-strong}"},
  "button-secondary-hover-background": {"$type": "color", "$value": "{color-bg-subtle}"},
  "button-ghost-foreground": {"$type": "color", "$value": "{color-primary}"},
  "button-ghost-hover-background": {"$type": "color", "$value": "{color-bg-subtle}"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-danger-hover-background": {"$type": "color", "$value": "{color-danger-hover}"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "button-default-padding-x": {"$type": "dimension", "$value": "{space-3}"},
  "button-default-gap": {"$type": "dimension", "$value": "{space-2}"},

  "card-default-background": {"$type": "color", "$value": "{color-bg}"},
  "card-default-foreground": {"$type": "color", "$value": "{color-fg}"},
  "card-default-border": {"$type": "color", "$value": "{color-border}"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-3}"},

  "input-default-background": {"$type": "color", "$value": "{color-bg}"},
  "input-default-foreground": {"$type": "color", "$value": "{color-fg}"},
  "input-default-border": {"$type": "color", "$value": "{color-border-strong}"},
  "input-default-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "input-invalid-border": {"$type": "color", "$value": "{color-danger}"}
}
